# intentionally NOT listed here — they're hand-curated reference data, still
# edited as JSON and seeded into the DB with `migrate_existing_data.py
# --seed-only` whenever you change them.
data/match_stats/raw/
data/xg_timeline/pl/*.json
data/xg_timeline/wc/*.json
data/xg_timeline/pl/*.csv
data/xg_timeline/wc/*.csv
data/imdb/
data/frontend/
outputs/

# models/*.joblib is intentionally kept in git — it's a small, versioned
# code artifact (the shipped model), not scraped data.
